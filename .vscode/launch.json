{
    // Debugging on the Raspberry Pi from the PC, with the debugger (vsdbg) installed in ~/vsdbg on the Pi.
    // The name of the Pi is in .vscode/settings.json.
    "version": "0.2.0",
    "configurations": [
        {
            // Deploys the project of the file open in the editor (open the Program.cs of a lesson and press F5),
            // runs it on the Pi with the debugger and stops the robot at the end. The debug console has no
            // keyboard: for programs that read keys, use "Adjuntar a un programa en la Pi".
            "name": "Depurar en la Pi el programa abierto",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "Desplegar el programa abierto",
            "postDebugTask": "Parar el robot",
            "program": "~/.dotnet/dotnet",
            // Relative to cwd: vsdbg expands "~" in program and cwd, but not in args
            "args": ["${fileDirnameBasename}.dll"],
            "cwd": "~/apps/${fileDirnameBasename}",
            "justMyCode": false,
            // The debug symbols use "/_/" for the repository folder (PathMap in Directory.Build.props)
            "sourceFileMap": {
                "/_/": "${workspaceFolder}/"
            },
            "stopAtEntry": false,
            "console": "internalConsole",
            // Don't fill the debug console with a line for every library loaded
            "logging": {
                "moduleLoad": false
            },
            "pipeTransport": {
                "pipeCwd": "${workspaceFolder}",
                "pipeProgram": "ssh",
                "pipeArgs": ["-T", "${config:explorerHat.host}"],
                "debuggerPath": "~/vsdbg/vsdbg"
            }
        },
        {
            // For programs that read the keyboard (like ObstacleAvoidance or Lesson04.Square): first run them
            // with the task "Ejecutar en la Pi", then attach the debugger and choose the "dotnet" process.
            // Stopping the debugger only detaches it: the program keeps running until Ctrl+C.
            "name": "Adjuntar a un programa en la Pi",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickRemoteProcess}",
            "justMyCode": false,
            // The debug symbols use "/_/" for the repository folder (PathMap in Directory.Build.props)
            "sourceFileMap": {
                "/_/": "${workspaceFolder}/"
            },
            "logging": {
                "moduleLoad": false
            },
            "pipeTransport": {
                "pipeCwd": "${workspaceFolder}",
                "pipeProgram": "ssh",
                "pipeArgs": ["-T", "${config:explorerHat.host}"],
                "debuggerPath": "~/vsdbg/vsdbg"
            }
        }
    ]
}
