{
    // Tasks to work from the PC: the program is compiled on the PC, copied to ~/apps on the
    // Raspberry Pi and run there through SSH. The name of the Pi is in .vscode/settings.json.
    // A program is chosen by its folder (lessons/LessonNN.Name or src/ExplorerHat.Name); on the Pi
    // it goes to ~/apps/<name of the folder>. "$(basename ...)" gives that name: the shell of the Pi
    // runs it (on macOS and Linux, the shell of the PC runs it first, with the same result).
    "version": "2.0.0",
    "windows": {
        // cmd.exe so that "&&" stops the chain when a step fails
        "options": {
            "shell": {
                "executable": "cmd.exe",
                "args": ["/d", "/c"]
            }
        }
    },
    "tasks": [
        {
            "label": "Desplegar en la Pi",
            "detail": "Compila una lección o un programa en el PC y lo copia a ~/apps en la Raspberry Pi",
            "type": "shell",
            "command": "dotnet publish ${input:program} -c Debug -r linux-arm64 --self-contained false -o publish/${input:program} && ssh ${config:explorerHat.host} \"rm -rf ~/apps/$(basename ${input:program}) && mkdir -p ~/apps\" && scp -r -q publish/${input:program} ${config:explorerHat.host}:apps/ && ssh ${config:explorerHat.host} \"chmod -R go-w ~/apps/$(basename ${input:program}) && sync\"",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Ejecutar en la Pi",
            "detail": "Despliega una lección o un programa y lo ejecuta en la Raspberry Pi (Ctrl+C para pararlo)",
            "type": "shell",
            "command": "dotnet publish ${input:program} -c Debug -r linux-arm64 --self-contained false -o publish/${input:program} && ssh ${config:explorerHat.host} \"rm -rf ~/apps/$(basename ${input:program}) && mkdir -p ~/apps\" && scp -r -q publish/${input:program} ${config:explorerHat.host}:apps/ && ssh -t ${config:explorerHat.host} \"chmod -R go-w ~/apps/$(basename ${input:program}) && sync && dotnet ~/apps/$(basename ${input:program})/$(basename ${input:program}).dll\"",
            "problemMatcher": "$msCompile",
            "presentation": {
                "focus": true,
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            // Used by "Depurar en la Pi el programa abierto" (launch.json): the program is the project
            // of the file open in the editor, so the task and the debugger don't ask for it twice
            "label": "Desplegar el programa abierto",
            "detail": "Despliega el proyecto del archivo abierto en el editor (lo usa la depuración)",
            "type": "shell",
            "command": "dotnet publish ${relativeFileDirname} -c Debug -r linux-arm64 --self-contained false -o publish/${fileDirnameBasename} && ssh ${config:explorerHat.host} \"rm -rf ~/apps/${fileDirnameBasename} && mkdir -p ~/apps\" && scp -r -q publish/${fileDirnameBasename} ${config:explorerHat.host}:apps/ && ssh ${config:explorerHat.host} \"chmod -R go-w ~/apps/${fileDirnameBasename} && sync\"",
            "problemMatcher": "$msCompile"
        },
        {
            // Emergency stop: asks the programs to stop (like Ctrl+C) and then forces every motor
            // and light pin low. It runs by itself when a debug session ends, because stopping
            // the debugger kills the program without letting it stop the motors.
            "label": "Parar el robot",
            "detail": "Para los programas del robot en la Raspberry Pi y pone a nivel bajo los pines de motores y luces",
            "type": "shell",
            "command": "ssh ${config:explorerHat.host} \"pkill -INT -f '[E]xplorerHat[.](BasicSample|ObstacleAvoidance|SonarDashboard)|[L]esson[0-9]+[.]'; sleep 1; pinctrl set 19,20,21,26,4,17,27,5,16 op dl\"",
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "program",
            "type": "pickString",
            "description": "¿Qué lección o programa?",
            "options": [
                "lessons/Lesson01.Lights",
                "lessons/Lesson02.TrafficLight",
                "lessons/Lesson03.Motors",
                "lessons/Lesson04.Square",
                "lessons/Lesson05.Buttons",
                "lessons/Lesson06.Distance",
                "lessons/Lesson09.Autonomous",
                "lessons/Lesson11.Odometry",
                "lessons/Lesson11.Straight",
                "lessons/Lesson11.Square",
                "lessons/Lesson12.Screen",
                "src/ExplorerHat.BasicSample",
                "src/ExplorerHat.ObstacleAvoidance",
                "src/ExplorerHat.SonarDashboard",
                "src/ExplorerHat.UpsDashboard"
            ],
            "default": "lessons/Lesson01.Lights"
        }
    ]
}
